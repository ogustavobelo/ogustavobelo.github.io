.vscode/

# Hugo build output
public/
resources/
.hugo_build.lock

# local/export data
bear-data/

# Python caches
.pytest_cache/
__pycache__/
**/__pycache__/

# Obsidian vault: track only our own plugins and the enabled-plugins list;
# workspace/graph state is per-machine noise, third-party plugins are reinstalled.
content/posts/.obsidian/*
!content/posts/.obsidian/community-plugins.json
!content/posts/.obsidian/plugins/
content/posts/.obsidian/plugins/*
!content/posts/.obsidian/plugins/hugo-image-shortcode/
!content/posts/.obsidian/plugins/hugo-spoiler-shortcode/
!content/posts/.obsidian/plugins/hugo-youtube-shortcode/
# Personal Hugo settings (see config/_default/params.toml.example)
config/_default/params.toml

# Generated Instagram stories (scripts/create_story.py)
stories/
